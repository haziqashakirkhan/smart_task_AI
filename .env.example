# Paste ONE key. The app detects the provider from the key's prefix.

# Option A: Groq (fast, free tier available). Key starts with gsk_
#   Create one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Option B: xAI Grok (paid). Key starts with xai-
#   Create one at https://console.x.ai
# XAI_API_KEY=xai-your-key-here

# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODELS=
# LLM_PROVIDER=groq        # only needed if auto-detection guesses wrong
